# Frontend staging environment
# Use this file as reference to configure Vercel Preview/Branch env vars.

# Backend API URL for staging backend deployment
VITE_API_BASE_URL="https://YOUR_BACKEND_STAGING_DOMAIN"
VITE_CHECKOUT_SAVED_ADDRESSES_ENABLED="false"

# Supabase public settings for STAGING project
VITE_SUPABASE_URL="https://YOUR_STAGING_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_STAGING_ANON_KEY"
VITE_SUPABASE_STORAGE_BUCKET="products"
VITE_SUPABASE_STORAGE_PUBLIC_BASE_URL="https://YOUR_STAGING_PROJECT_REF.supabase.co/storage/v1/object/public/products"

# Optional if used in your current setup
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="https://YOUR_FRONTEND_STAGING_DOMAIN"
